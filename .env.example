# ─── NOTION ───────────────────────────────────────────────────────────────────
# Crie sua integração em: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs dos bancos de dados (pegue na URL do banco no Notion)
# Ex: https://notion.so/workspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
#                                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ este é o ID
NOTION_CONTEUDOS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_IDEIAS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_RELATORIOS_DB=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── YOUTUBE ──────────────────────────────────────────────────────────────────
# Crie sua API Key em: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do canal: acesse seu canal, está na URL /channel/UCxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx

# ─── INSTAGRAM ────────────────────────────────────────────────────────────────
# Token de acesso da Graph API (conta Business/Creator + Facebook Page)
# Guia: https://developers.facebook.com/docs/instagram-basic-display-api
INSTAGRAM_ACCESS_TOKEN=IGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID do usuário: retornado pela API ao autenticar
INSTAGRAM_USER_ID=xxxxxxxxxxxxxxxxx

# ─── LEMBRETES (app em lembretes/) ────────────────────────────────────────────
# Banco: crie em https://console.upstash.com → aba REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Interpretação do recado: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Push: gere com `cd lembretes && npm run gen:vapid`
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:beareisfarma@gmail.com

# Acesso ao app e ao cron — gere com `openssl rand -base64 24`
APP_PIN=troque-por-um-segredo-longo
CRON_SECRET=troque-por-outro-segredo-longo

# Transcrição do áudio (uma das duas)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional (padrão America/Sao_Paulo)
# FUSO_HORARIO=America/Sao_Paulo
